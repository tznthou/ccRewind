{
  "name": "ccrewind",
  "version": "1.28.1",
  "description": "Claude Code 對話回放與考古工具",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && install-electron && electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-builder build --config electron-builder.yml",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.config.json --noEmit",
    "lint": "eslint . --fix",
    "test": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run --coverage",
    "postinstall": "electron-rebuild -f -o better-sqlite3"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "13.0.3",
    "highlight.js": "^11.12.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  }
}
